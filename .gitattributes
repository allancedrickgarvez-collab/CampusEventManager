# Normalise line endings for the whole team so nobody commits a
# "whole file changed" diff just because they are on Windows.
* text=auto

# Source and scripts: LF in the repository
*.kt      text eol=lf
*.java    text eol=lf
*.kts     text eol=lf
*.xml     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.pro     text eol=lf
*.properties text eol=lf
*.toml    text eol=lf
gradlew   text eol=lf

# Windows launcher must stay CRLF
*.bat     text eol=crlf

# Binary assets -- never touch these
*.jar     binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.ttf     binary
*.otf     binary
*.apk     binary
*.aab     binary
*.keystore binary
*.jks     binary
